# Скопируйте в .env для локальной сборки и предпросмотра.
# .env в git не попадает.

# Локальный Telegram (для npm run preview)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Соль для необратимого хеша IP
RATE_SALT=local-dev-only

# Cloudflare Turnstile (публичный sitekey + секрет)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Адрес сайта и публичные токены (можно оставить пустыми)
SITE_URL=https://artem-portfolio-7m4.pages.dev
CF_BEACON_TOKEN=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
