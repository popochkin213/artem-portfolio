# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НИКОГДА не попадает в git (он в .gitignore).

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата, куда присылать заявки (ваш личный chat_id)
TELEGRAM_CHAT_ID=

# Прокси — нужен ТОЛЬКО локально, если Telegram недоступен напрямую
# (например, включён VPN-клиент с HTTP-прокси). На сервере оставьте пустым.
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809

# Порт (необязательно)
PORT=8000
